{
  "name": "zr-player-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "node scripts/electron-dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "vite build && node scripts/build-electron.mjs",
    "electron:start": "npm run build:desktop && electron .",
    "test:electron": "node scripts/electron-test.mjs",
    "dist:win": "npm run build:desktop && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build:desktop && electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.64.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "productName": "Nikon ZR LUT Player",
  "description": "LUT video player and proxy colorist viewer for Nikon ZR footage",
  "author": "Nikon ZR LUT Player",
  "main": "dist-electron/main.cjs"
}
